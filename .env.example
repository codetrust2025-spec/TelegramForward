# Copy to .env on the VPS. Do not commit .env.

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

OPS_API_TOKEN=

# Optional comma-separated additional company UPI IDs accepted by the public
# slot-booking payment verifier. The primary ID comes from Karthik settings.
COMPANY_PAYMENT_UPI_IDS=
COMPANY_PAYMENT_PHONE_NUMBERS=

WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BSP=interakt

DEMO_TOOLS_LOCKEDIN_WINDOWS_URL=
DEMO_TOOLS_LOCKEDIN_MAC_URL=
DEMO_TOOLS_ULTRAVIEWER_URL=

# Ollama. Production uses Jagadeesh's appliance through VPS loopback port 11435.
# Local development may override this with http://127.0.0.1:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_PRIMARY_NODE=jagadeesh
OLLAMA_NODE_JAGADEESH_URL=http://127.0.0.1:11435
OLLAMA_NODE_OUR_MACHINE_URL=http://127.0.0.1:11436
OLLAMA_NODE_STATE_FILE=data/ollama_nodes_state.json
OLLAMA_REMOTE_ENABLED=true
OLLAMA_EXPECT_REVERSE_SSH_TUNNEL=true
OLLAMA_INFERENCE_HOST_ID=jagadeesh-ollama
OLLAMA_LOCAL_FALLBACK_ENABLED=false
OLLAMA_FALLBACK_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_REQUEST_TIMEOUT=300
AI_JOB_TIMEOUT=660
OLLAMA_KEEP_ALIVE=5m
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_RESPONSE_TIMEOUT_SECONDS=300
OLLAMA_HEALTH_TIMEOUT_SECONDS=10
OLLAMA_DIAGNOSTIC_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=1
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
OLLAMA_BACKUP_VISION_MODEL=moondream
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_PRIMARY_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=300
OLLAMA_RETRY_COUNT=1
# Legacy alias; OLLAMA_PRIMARY_MODEL is preferred for recruitment email routing.
OLLAMA_MAIL_MODEL=
OLLAMA_CONFIDENCE_THRESHOLD=0.90
# Temporary screenshot test mode. Set to ollama_only to bypass OCR and use
# Ollama vision models only; users must verify the extracted fields.
INVITE_EXTRACTION_MODE=
# Global OCR/Tesseract switch. Invite OCR may authorize automatic extraction
# only for explicit labelled date/start-time text with a supported timezone.
OCR_ENABLED=true
PAYMENT_VERIFICATION_OCR_ENABLED=false
PAYMENT_ENGINE_V2_ENABLED=true
PAYMENT_EXTRACTION_PROVIDER=OLLAMA
REFERRER_RECEIVER_FLOW_ENABLED=true
PAYMENT_MIN_EXTRACTION_CONFIDENCE=80
PAYMENT_DEFAULT_COMMISSION_PCT=50
# Optional per-referrer overrides, e.g. {"Thrilok":50,"Referrer One":40}
PAYMENT_COMMISSION_RULES_JSON=
PAYMENT_EVIDENCE_MAX_BYTES=10485760
# Optional JSON array/dict of deterministic referrer receiver identities.
# Example: [{"name":"Thrilok","upi_ids":["name@bank"],"phones":["9999999999"]}]
PAYMENT_REFERRER_RECEIVERS_JSON=
PAYMENT_RECEIVER_REGISTRY_FILE=
# Stable referrer identities materialized from the existing candidate reference data.
REFERRER_REGISTRY_FILE=
COMPANY_PAYMENT_RECEIVER_NAMES=Sample Receiver
COMPANY_PAYMENT_ACCOUNT_NUMBERS=

# AI Interview, Offer and Candidate Mail Tracking (disabled by default)
AI_INTERVIEW_OFFER_TRACKING_ENABLED=false
AI_MAILBOX_SYNC_ENABLED=false
AI_OFFER_VERIFICATION_ENABLED=false
AI_MAIL_SYNC_INTERVAL_MINUTES=15
AI_MAIL_SYNC_BATCH_SIZE=50
AI_MAIL_SYNC_MAX_RETRIES=5
AI_MAIL_SYNC_MAX_CONCURRENCY=5
AI_MAIL_WEBSOCKET_HEARTBEAT_SECONDS=30
AI_MAIL_NOTIFICATION_FALLBACK_SECONDS=30
AI_INTERVIEW_AUTO_BOOKING_ENABLED=false
AI_INTERVIEW_AUTO_BOOK_THRESHOLD=0.90
AI_INTERVIEW_REVIEW_THRESHOLD=0.80
AI_INTERVIEW_DEFAULT_DURATION_MINUTES=30
# Domain-scoped fallback for authenticated plain-text invitations that omit a timezone.
AI_INTERVIEW_DEFAULT_TIMEZONE=Asia/Kolkata
AI_INTERVIEW_DEFAULT_TIMEZONE_DOMAINS=tcs.com
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
GMAIL_PUSH_WEBHOOK_URL=https://teleautomation.online/api/gmail/pubsub/push
AI_RECRUITMENT_FILTER_THRESHOLD=0.55
AI_RECRUITMENT_MODEL=
AI_RECRUITMENT_FALLBACK_MODEL=qwen2.5:7b
AI_RECRUITMENT_VALIDATOR_MODEL=qwen2.5:7b
AI_RECRUITMENT_AUTO_ACCEPT_THRESHOLD=0.90
AI_RECRUITMENT_TIMEOUT_SECONDS=300
AI_RECRUITMENT_REQUEST_TIMEOUT_SECONDS=300
AI_RECRUITMENT_JOB_TIMEOUT_SECONDS=660
AI_RECRUITMENT_QUEUE_WAIT_SECONDS=120
AI_RECRUITMENT_MAX_RETRIES=1
AI_OLLAMA_MAX_CONCURRENCY=1
AI_MAIL_AI_RETRY_BATCH_SIZE=3
AI_MAIL_AI_LEASE_SECONDS=150
AI_MAIL_INGESTION_LEASE_MINUTES=5

# Google OAuth read-only Gmail access. Generate the Fernet key outside the repo.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/candidate-mailboxes/oauth/google/callback
MAILBOX_CREDENTIAL_ENCRYPTION_KEY=
