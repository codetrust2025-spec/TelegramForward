# Copy to .env on the VPS. Do not commit .env.

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

OPS_API_TOKEN=

WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BSP=interakt

DEMO_TOOLS_LOCKEDIN_WINDOWS_URL=
DEMO_TOOLS_LOCKEDIN_MAC_URL=
DEMO_TOOLS_ULTRAVIEWER_URL=

# Ollama (runs on laptop, tunneled to VPS via SSH reverse tunnel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_RESPONSE_TIMEOUT_SECONDS=180
OLLAMA_HEALTH_TIMEOUT_SECONDS=10
OLLAMA_DIAGNOSTIC_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=3
# Set true on the VPS when 127.0.0.1:11434 is supplied by the laptop reverse SSH tunnel.
OLLAMA_EXPECT_REVERSE_SSH_TUNNEL=false
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_BACKUP_VISION_MODEL=moondream
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_PRIMARY_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=900
OLLAMA_RETRY_COUNT=1
# Legacy alias; OLLAMA_PRIMARY_MODEL is preferred for recruitment email routing.
OLLAMA_MAIL_MODEL=
OLLAMA_CONFIDENCE_THRESHOLD=0.90

# AI Interview, Offer and Candidate Mail Tracking (disabled by default)
AI_INTERVIEW_OFFER_TRACKING_ENABLED=false
AI_MAILBOX_SYNC_ENABLED=false
AI_OFFER_VERIFICATION_ENABLED=false
AI_MAIL_SYNC_INTERVAL_MINUTES=15
AI_MAIL_SYNC_BATCH_SIZE=50
AI_MAIL_SYNC_MAX_RETRIES=5
AI_MAIL_SYNC_MAX_CONCURRENCY=5
AI_MAIL_WEBSOCKET_HEARTBEAT_SECONDS=30
AI_MAIL_NOTIFICATION_FALLBACK_SECONDS=30
AI_INTERVIEW_AUTO_BOOKING_ENABLED=false
AI_INTERVIEW_AUTO_BOOK_THRESHOLD=0.90
AI_INTERVIEW_REVIEW_THRESHOLD=0.80
AI_INTERVIEW_DEFAULT_DURATION_MINUTES=30
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
GMAIL_PUSH_WEBHOOK_URL=https://teleautomation.online/api/gmail/pubsub/push
AI_RECRUITMENT_FILTER_THRESHOLD=0.55
AI_RECRUITMENT_MODEL=
AI_RECRUITMENT_FALLBACK_MODEL=qwen2.5:7b
AI_RECRUITMENT_VALIDATOR_MODEL=qwen2.5:7b
AI_RECRUITMENT_AUTO_ACCEPT_THRESHOLD=0.90
OLLAMA_VISION_MODEL=qwen2.5vl:7b
AI_RECRUITMENT_TIMEOUT_SECONDS=180
AI_RECRUITMENT_MAX_RETRIES=1
AI_OLLAMA_MAX_CONCURRENCY=1

# Google OAuth read-only Gmail access. Generate the Fernet key outside the repo.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/candidate-mailboxes/oauth/google/callback
MAILBOX_CREDENTIAL_ENCRYPTION_KEY=
